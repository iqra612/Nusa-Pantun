# Copy to .env and edit. Never commit .env.

# Database. Leave empty for SQLite (data/pirs.db). PostgreSQL example:
# PIRS_DB_URL=postgresql+psycopg2://user:password@localhost:5432/pirs
PIRS_DB_URL=

# Dense embeddings (needs sentence-transformers). Set to 0 to use TF-IDF only.
PIRS_USE_DENSE=1
PIRS_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# A search counts as "successful" in the usage dashboard when the top match is at least this percentage.
PIRS_SUCCESS_PCT=50

# Admin login. Create the hash with:  python -m database.auth "your-password"
PIRS_ADMIN_USER=admin
PIRS_ADMIN_PASSWORD_HASH=
